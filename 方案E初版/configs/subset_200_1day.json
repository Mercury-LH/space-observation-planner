{
  "name": "subset_200_1day",
  "description": "真实数据固定随机子集；起始日期与目标计分方式为开发假设。",
  "data_root": "data/开运联合",
  "start_utc": "2026-08-04T00:00:00Z",
  "days": 1,
  "target_limit": 200,
  "selection_seed": 20261020,
  "rules": {
    "min_duration_s": 120,
    "full_duration_s": 240,
    "switch_s": 30,
    "score_mode": "step",
    "objective": "coverage_then_score",
    "repeat_gap_s": null,
    "max_observations_per_target": 1
  },
  "windows": {
    "workers": 1,
    "scan_step_s": 30,
    "target_chunk": 32,
    "time_chunk_s": 21600,
    "root_tolerance_s": 0.01,
    "cache_dir": "outputs/window_cache"
  },
  "seeds": [0, 1, 2],
  "alns_iterations": 100,
  "alns_time_limit_s": 60,
  "development_assumptions": [
    "2026-08-04 UTC起始，仅为靠近TLE历元的开发选择",
    "每个目标最多观测一次，无48小时重复间隔",
    "覆盖优先、观测得分次之，不采用覆盖与得分各50%的未确认规则",
    "120至240秒之间保守保持60%得分，240秒达到100%",
    "仅几何仰角约束，不添加未确认太阳高度或天气限制"
  ]
}
